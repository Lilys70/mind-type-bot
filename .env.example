# Скопируйте этот файл в .env и вставьте реальный токен.
# Токен выдаёт @BotFather в Telegram: /newbot -> имя бота -> токен.
# Файл .env в репозиторий не попадает (он в .gitignore).
BOT_TOKEN=ваш_токен_здесь

# Кому уходят заявки на консультацию: ваш Telegram-id.
# Как его узнать: отправьте боту любое сообщение и посмотрите
# «Telegram-id отправителя» в консоли терминала (печатается
# с каждой заявкой, пока поле пустое).
MANAGER_CHAT_ID=ваш_id

# Прокси (опционально). Раскомментируйте и заполните, если api.telegram.org
# не доступен напрямую.
# Пример: http://user:pass@host:port или socks5://host:port
PROXY_URL=
