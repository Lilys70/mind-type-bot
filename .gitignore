# Служебные папки и секреты в репозиторий не попадают.
venv/
__pycache__/
*.pyc

# Токен бота и id менеджера хранятся только локально.
.env

# Скриншоты ТЗ Zerocoder: чужие учебные материалы, в GitHub не идут.
_Документы/

# Скриншоты работы лежат в Медиа и публикуются: они свои, без ПД.
!Медиа/*.jpg
!Медиа/*.png

# Заявки заказчиков — персональные данные, их не коммитим.
хранилище/заявки.json
хранилище/заявки.битые.*.json
хранилище/*.tmp
